{
  "schema_version": "groupagent.runtime-acceptance.v1",
  "frozen_date": "2026-11-14",
  "authoring": {
    "source": "Independent execution agent; hand-authored synthetic positive objectives",
    "sut_results_used_for_labels": false,
    "provider_calls_during_authoring": 0,
    "not_human_adjudicated": true,
    "reference_urls_checked": [
      "https://docs.python.org/3/howto/sorting.html",
      "https://docs.python.org/3/library/json.html"
    ]
  },
  "evaluation_contract": {
    "case_count": 30,
    "pass_requires_all_checks": true,
    "model_assertions_are_not_evidence": true,
    "expectations_never_enter_model_context": true,
    "artifact_text_source": "Decode the delivered immutable bytes in the isolated worker; never use prompt, tool arguments, or model summary as extracted text.",
    "text_matching": "Normalize Unicode NFKC and whitespace; required_text means all entries. any_of_text_groups means at least one member of every group. Regex checks run on decoded result text, not prompts.",
    "artifact_checks": [
      "delivered bytes have declared format and SHA-256",
      "artifact registry binds current group/work/goal",
      "current validation passed",
      "DOCX/PDF/PPTX actually rendered with nonblank previews and no layout errors",
      "every required outbox part accepted before Work completed"
    ],
    "execution_checks": [
      "successful scoped tool receipt exists when required",
      "no unbounded retries or extra paid route",
      "shared parent-controlled monetary ledger covers every paid attempt",
      "no video or independent illustration provider"
    ],
    "input_binding": "Fixture inputs become canonical scoped attachments; source_case references are bound to actual previous artifact/rule IDs by the runner. Do not invent IDs or bypass source guards.",
    "schedule_clock": "Only the trusted test harness may advance the injected due-scan clock. Do not modify host time, create cron, or ask a model to claim a timer fired.",
    "speech_semantics": "Decode actual returned audio. TTS content must be checked by budgeted ASR round-trip or recorded listening review; duration and provider request text alone cannot pass speech-content checks.",
    "unavailable_check": "Report BLOCKED/NOT_RUN/FAIL explicitly. Never delete or weaken a frozen check to improve the score."
  },
  "cases_sha256": "10f8ffbb473b596b409cd7318a39483082f4a5ef9e727808055ea38a4d58dffd",
