[Unit]
Description=Pot test_2 controller with a restricted Docker broker
After=docker.service pot-test2-docker-proxy.service pot-test2-postgres-container.service
Requires=docker.service pot-test2-docker-proxy.service pot-test2-postgres-container.service
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
ExecStartPre=/usr/bin/python3 /opt/pot-test2/app/deploy/prepare_pot_runtime_secrets.py --legacy-config /home/admin/wechat-leader/config.local.json --channel-token /home/admin/wechat-leader/data/native/api-token
ExecStart=/bin/bash /opt/pot-test2/app/deploy/launch-pot-test2-container.sh controller
ExecStop=-/usr/bin/docker stop --time 30 pot-test2
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillMode=process
UMask=0077
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
