[Unit]
Description=Pot fixed-image, fixed-group Docker broker
After=docker.service
Requires=docker.service
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
ExecStart=/bin/bash /opt/pot-test2/app/deploy/launch-pot-test2-container.sh broker
ExecStop=-/usr/bin/docker stop --time 10 pot-test2-docker-proxy
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=process
UMask=0077
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
